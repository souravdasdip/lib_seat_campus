# Backend local environment.
# Copy this file to .env for local development. Do not commit real secrets.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5121

ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=lib_seat_campus;Username=postgres;Password=123;SSL Mode=Disable;

JwtSettings__Key=replace-with-a-long-random-secret-at-least-32-chars
JwtSettings__Issuer=LibraryExamAPI
JwtSettings__Audience=LibraryExamClient

ClientApp__AllowedOrigins=http://localhost:5173,http://127.0.0.1:5173

DefaultAdmin__Email=admin@library.edu
DefaultAdmin__Password=Admin@123

Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=your-email@gmail.com
Smtp__Password=your-app-password
Smtp__From=noreply@library.edu
Smtp__EnableSsl=true
